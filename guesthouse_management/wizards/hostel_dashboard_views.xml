<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hostel_dashboard_view_form" model="ir.ui.view">
        <field name="name">hostel.dashboard.form</field>
        <field name="model">hostel.dashboard</field>
        <field name="arch" type="xml">
            <form class="o_hst_dashboard">
                <sheet>
                    <!-- Branded hero band: deliberately contains only text/branding, no form
                         inputs. Odoo's own input widgets carry their own light-theme colors and
                         would be unreadable on a dark gradient - the filters stay below on the
                         normal background where their standard styling still works. -->
                    <div class="o_hst_hero">
                        <div class="o_hst_hero_mark"><i class="fa fa-bed" title="Hostel Management"/></div>
                        <div>
                            <div class="o_hst_hero_eyebrow">Hostel Management</div>
                            <h1 class="o_hst_hero_title">Front Desk Dashboard</h1>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>

                    <h3 class="o_hst_dashboard_section">Right Now</h3>
                    <div class="o_hst_kpi_grid">
                        <div class="o_hst_kpi_card o_hst_kpi_accent">
                            <div class="o_hst_kpi_icon"><i class="fa fa-sign-in" title="Arrivals"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="arrivals_today_count" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Confirmed bookings with a check-in date of today.">Arrivals Today</span>
                            </div>
                        </div>
                        <div class="o_hst_kpi_card o_hst_kpi_warning">
                            <div class="o_hst_kpi_icon"><i class="fa fa-sign-out" title="Departures"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="departures_today_count" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Checked-in bookings with a check-out date of today.">Departures Today</span>
                            </div>
                        </div>
                        <div class="o_hst_kpi_card o_hst_kpi_primary">
                            <div class="o_hst_kpi_icon"><i class="fa fa-bed" title="In-house"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="in_house_count" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Bookings currently checked in - guests physically on-site right now, listed below in In-House Guests.">In-House Now</span>
                            </div>
                        </div>
                        <div class="o_hst_kpi_card">
                            <div class="o_hst_kpi_icon"><i class="fa fa-pie-chart" title="Occupancy"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="occupancy_ratio_today" widget="percentage" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Beds currently occupied ÷ total beds, right now. Bed-based: a dorm with free bunks counts as partly occupied, not fully.">Today's Occupancy</span>
                                <field name="occupancy_status" widget="badge"
                                       decoration-success="occupancy_status == 'success'"
                                       decoration-warning="occupancy_status == 'warning'"
                                       decoration-info="occupancy_status == 'primary'"
                                       nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <h3 class="o_hst_dashboard_section">Needs Attention</h3>
                    <div class="o_hst_kpi_grid">
                        <div class="o_hst_kpi_card o_hst_kpi_alert o_hst_kpi_warning">
                            <div class="o_hst_kpi_icon"><i class="fa fa-paint-brush" title="Housekeeping"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="pending_housekeeping_count" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Housekeeping tasks still Pending or In Progress (not yet Done or Verified).">Housekeeping Tasks Open</span>
                            </div>
                        </div>
                        <div class="o_hst_kpi_card o_hst_kpi_alert o_hst_kpi_danger">
                            <div class="o_hst_kpi_icon"><i class="fa fa-exclamation-triangle" title="Overdue invoices"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="overdue_invoice_count" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Invoiced folios whose invoice is past its due date and still not fully paid - the same set the daily overdue-invoice reminder notifies staff about.">Overdue Invoices</span>
                            </div>
                        </div>
                    </div>

                    <h3 class="o_hst_dashboard_section">This Period</h3>
                    <div class="o_hst_kpi_grid">
                        <div class="o_hst_kpi_card o_hst_kpi_success">
                            <div class="o_hst_kpi_icon"><i class="fa fa-usd" title="Revenue"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="revenue_period" widget="monetary" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="For every stay overlapping the date range: nights inside the range × that booking's locked-in nightly rate, summed across every room type.">Revenue</span>
                            </div>
                        </div>
                        <div class="o_hst_kpi_card o_hst_kpi_accent">
                            <div class="o_hst_kpi_icon"><i class="fa fa-moon-o" title="Nights sold"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="nights_sold_period" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Total nights actually stayed within the date range, across every room type - only the portion of each stay inside the range counts.">Nights Sold</span>
                            </div>
                        </div>
                        <div class="o_hst_kpi_card o_hst_kpi_primary">
                            <div class="o_hst_kpi_icon"><i class="fa fa-tag" title="ADR"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="adr_period" widget="monetary" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Average Daily Rate = Revenue ÷ Nights Sold - the average nightly rate actually charged, blended across every room type and booking.">Avg. Daily Rate</span>
                            </div>
                        </div>
                        <div class="o_hst_kpi_card">
                            <div class="o_hst_kpi_icon"><i class="fa fa-line-chart" title="Occupancy"/></div>
                            <div class="o_hst_kpi_body">
                                <span class="o_hst_kpi_value"><field name="occupancy_ratio_period" widget="percentage" nolabel="1"/></span>
                                <span class="o_hst_kpi_label" title="Total Nights Sold ÷ total Available Room-Nights across every room type in the period.">Avg. Occupancy</span>
                            </div>
                        </div>
                    </div>

                    <h3 class="o_hst_dashboard_section">By Room Type</h3>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0" class="o_hst_list">
                            <field name="room_type_id"/>
                            <field name="nights_sold"/>
                            <field name="available_room_nights" string="Available"/>
                            <field name="occupancy_ratio" widget="percentage"/>
                            <field name="adr" widget="monetary"/>
                            <field name="revenue" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>

                    <h3 class="o_hst_dashboard_section">In-House Guests</h3>
                    <field name="in_house_booking_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0" class="o_hst_list">
                            <field name="booking_id"/>
                            <field name="guest_id"/>
                            <field name="room_display_name" string="Room/Bed"/>
                            <field name="reference_date" string="Checkout Date"/>
                        </list>
                    </field>

                    <h3 class="o_hst_dashboard_section">Upcoming Arrivals (Next 7 Days)</h3>
                    <field name="upcoming_arrival_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0" class="o_hst_list">
                            <field name="booking_id"/>
                            <field name="guest_id"/>
                            <field name="room_display_name" string="Room/Bed"/>
                            <field name="reference_date" string="Check-in Date"/>
                        </list>
                    </field>

                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hostel_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">hostel.dashboard</field>
        <field name="view_mode">form</field>
        <field name="context">{'form_view_ref': 'guesthouse_management.hostel_dashboard_view_form'}</field>
    </record>
</odoo>
