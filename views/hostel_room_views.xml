<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hostel_room_view_kanban" model="ir.ui.view">
        <field name="name">hostel.room.kanban</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <kanban class="o_hst_kanban">
                <field name="state_color" invisible="1"/>
                <field name="housekeeping_status_color" invisible="1"/>
                <templates>
                    <t t-name="card">
                        <div class="o_hst_title"><field name="name"/></div>
                        <div class="o_hst_meta">
                            <field name="room_type_id"/> · Floor <field name="floor"/>
                        </div>
                        <div class="d-flex gap-1 mt-1">
                            <span t-attf-class="o_hst_pill o_hst_pill_#{record.state_color.raw_value}">
                                <field name="state"/>
                            </span>
                            <span t-attf-class="o_hst_pill o_hst_pill_#{record.housekeeping_status_color.raw_value}">
                                <field name="housekeeping_status"/>
                            </span>
                        </div>
                        <footer t-if="record.housekeeping_status_color.raw_value == 'warning'">
                            <button name="action_mark_clean" type="object" string="Mark Clean" class="btn btn-sm btn-primary"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hostel_room_view_list" model="ir.ui.view">
        <field name="name">hostel.room.list</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <list class="o_hst_list">
                <field name="name"/>
                <field name="property_id"/>
                <field name="floor"/>
                <field name="room_type_id"/>
                <field name="capacity"/>
                <field name="state"/>
                <field name="housekeeping_status"/>
            </list>
        </field>
    </record>

    <record id="hostel_room_view_form" model="ir.ui.view">
        <field name="name">hostel.room.form</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <form class="o_hst_form">
                <header>
                    <button name="action_mark_clean" type="object" string="Mark Clean"
                            class="btn-primary" invisible="housekeeping_status == 'clean'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. 101"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="housekeeping_status"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Beds" name="beds">
                            <field name="bed_ids">
                                <list editable="bottom" class="o_hst_list">
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="is_female_only"/>
                                    <field name="is_bottom_bunk"/>
                                </list>
                            </field>
                        </page>
                        <page string="Housekeeping Tasks" name="housekeeping_tasks">
                            <field name="housekeeping_task_ids">
                                <list class="o_hst_list">
                                    <field name="date"/>
                                    <field name="type_id"/>
                                    <field name="assigned_to_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hostel_room_view_search" model="ir.ui.view">
        <field name="name">hostel.room.search</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <filter string="Available" name="filter_available" domain="[('state', '=', 'available')]"/>
                <filter string="Occupied" name="filter_occupied" domain="[('state', '=', 'occupied')]"/>
                <filter string="Maintenance" name="filter_maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter string="Out of Order" name="filter_out_of_order" domain="[('state', '=', 'out_of_order')]"/>
                <separator/>
                <filter string="Needs Cleaning" name="filter_dirty" domain="[('housekeeping_status', '=', 'dirty')]"/>
                <group>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Room Type" name="group_room_type" context="{'group_by': 'room_type_id'}"/>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Housekeeping Status" name="group_housekeeping_status" context="{'group_by': 'housekeeping_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hostel_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hostel.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_property': 1}</field>
    </record>
</odoo>
